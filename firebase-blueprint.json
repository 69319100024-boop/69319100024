{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private profile and default preferences for an authenticated DBTech Ledger user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google/Gmail address of the user",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the workspace",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL from Google Auth",
          "maxLength": 500
        },
        "defaultMonthlyBudget": {
          "type": "number",
          "description": "Default monthly spending limit in THB"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "defaultMonthlyBudget", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Individual income or expense entry owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Transaction direction: income or expense"
        },
        "title": {
          "type": "string",
          "description": "Short title describing the income or expense",
          "minLength": 1,
          "maxLength": 120
        },
        "amount": {
          "type": "number",
          "description": "Positive monetary amount in THB"
        },
        "category": {
          "type": "string",
          "description": "Category name in Thai",
          "minLength": 1,
          "maxLength": 60
        },
        "date": {
          "type": "string",
          "description": "Calendar date in YYYY-MM-DD format",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "monthKey": {
          "type": "string",
          "description": "Month grouping key in YYYY-MM format",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "bank_transfer", "promptpay", "credit_card", "other"],
          "description": "Payment channel used for the transaction"
        },
        "note": {
          "type": "string",
          "description": "Optional additional note",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["userId", "type", "title", "amount", "category", "date", "monthKey", "paymentMethod", "createdAt", "updatedAt"]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Per-month expense budget limit set by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthKey": {
          "type": "string",
          "description": "Month key in YYYY-MM format",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "limitAmount": {
          "type": "number",
          "description": "Monthly spending cap in THB"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": ["userId", "monthKey", "limitAmount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile documents isolated strictly to each owner."
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "User-owned income and expense ledger entries."
    },
    "/budgets/{budgetId}": {
      "schema": {
        "$ref": "#/entities/MonthlyBudget"
      },
      "description": "Monthly spending budget limits keyed as {userId}_{YYYY-MM}."
    }
  }
}
