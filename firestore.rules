rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isEmailVerified() && request.auth.uid == userId;
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'defaultMonthlyBudget', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'defaultMonthlyBudget', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email == request.auth.token.email
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.defaultMonthlyBudget is number && data.defaultMonthlyBudget >= 0 && data.defaultMonthlyBudget <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'amount', 'category', 'date', 'monthKey', 'paymentMethod', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'type', 'title', 'amount', 'category', 'date', 'monthKey', 'paymentMethod', 'note', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.type in ['income', 'expense']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.amount is number && data.amount > 0 && data.amount <= 1000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.date[0:7] == data.monthKey
        && data.paymentMethod in ['cash', 'bank_transfer', 'promptpay', 'credit_card', 'other']
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid && isValidId(data.userId)
        && data.monthKey is string && data.monthKey.size() == 7 && data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
        && data.limitAmount is number && data.limitAmount >= 0 && data.limitAmount <= 1000000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Private User Profiles (PII isolated strictly to owner; listing prohibited)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['defaultMonthlyBudget', 'updatedAt'])
        );
      allow delete: if false;
    }

    // 2. User-Owned Income & Expense Transactions
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isEmailVerified() && existing().userId == request.auth.uid;
      allow list: if isEmailVerified() && existing().userId == request.auth.uid;
      allow create: if isEmailVerified()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isEmailVerified()
        && isValidId(transactionId)
        && isValidTransaction(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'title', 'amount', 'category', 'date', 'monthKey', 'paymentMethod', 'note', 'updatedAt']);
      allow delete: if isValidId(transactionId) && isEmailVerified() && existing().userId == request.auth.uid;
    }

    // 3. Monthly Spending Budgets (keyed by {userId}_{YYYY-MM})
    match /budgets/{budgetId} {
      allow get: if isValidId(budgetId) && isEmailVerified() && existing().userId == request.auth.uid;
      allow list: if isEmailVerified() && existing().userId == request.auth.uid;
      allow create: if isEmailVerified()
        && isValidId(budgetId)
        && isValidBudget(incoming())
        && budgetId == (request.auth.uid + '_' + incoming().monthKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isEmailVerified()
        && isValidId(budgetId)
        && isValidBudget(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().monthKey == existing().monthKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['limitAmount', 'updatedAt']);
      allow delete: if isValidId(budgetId) && isEmailVerified() && existing().userId == request.auth.uid;
    }
  }
}
